# Copy to .env and adjust values: cp .env.example .env

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notion_clone
DB_USER=notionuser
DB_PASS=changeme

# App
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Auth — generate a long random value, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=86400

# File uploads (relative to backend/)
UPLOAD_DIR=uploads

# WebSocket server
WEBSOCKET_PORT=8080

# CORS — comma-separated list of origins allowed to make credentialed requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
